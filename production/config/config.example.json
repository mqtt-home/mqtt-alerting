{
  "mqtt": {
    "url": "tcp://10.10.1.3:1883",
    "topic": "home/alerting",
    "qos": 2,
    "retain": true
  },
  "prometheus": {
    "url": "http://prometheus.example:9090",
    "interval": "1m"
  },
  "mail": {
    "smtp": {
      "enabled": true,
      "host": "smtp.example.com",
      "port": 587,
      "username": "${SMTP_USER}",
      "password": "${SMTP_PASS}",
      "from": "${SMTP_USER}",
      "to": "${MAIL_TO}"
    },
    "subject_prefix": "[smarthome]",
    "ui_url": "https://alerting.example.com",
    "batch_seconds": 60,
    "max_mails_per_hour": 6,
    "rules": [
      {
        "name": "bridge-offline",
        "description": "a bridge lost its connection to the broker or crashed",
        "title": "{device} bridge is offline",
        "resolved_title": "{device} bridge is back online",
        "type": "state",
        "topics": [
          "+/bridge/state",
          "+/+/bridge/state"
        ],
        "exclude": [
          "test/#"
        ],
        "condition": {
          "equals": "offline"
        },
        "for": "10m",
        "repeat": "24h"
      },
      {
        "name": "zigbee2mqtt-offline",
        "description": "zigbee2mqtt publishes its state as JSON",
        "title": "zigbee2mqtt is offline",
        "resolved_title": "zigbee2mqtt is back online",
        "type": "state",
        "topics": [
          "zigbee2mqtt/bridge/state"
        ],
        "condition": {
          "field": "state",
          "equals": "offline"
        },
        "for": "10m",
        "repeat": "24h"
      },
      {
        "name": "device-unavailable",
        "description": "the bridge runs, but cannot reach the device behind it",
        "title": "{device} is unreachable",
        "resolved_title": "{device} is reachable again",
        "type": "state",
        "topics": [
          "+/+/availability",
          "+/availability",
          "+/+/+/availability"
        ],
        "exclude": [
          "test/#"
        ],
        "condition": {
          "equals": "offline"
        },
        "for": "30m",
        "repeat": "24h"
      },
      {
        "name": "reconnect-loop",
        "description": "looks alive but keeps reconnecting or restarting",
        "title": "{device} is stuck in a reconnect loop",
        "resolved_title": "{device} stopped reconnecting",
        "type": "count",
        "topics": [
          "+/+/bridge/logs"
        ],
        "condition": {
          "regex": "Reconnect attempt|WATCHDOG|Connection failed"
        },
        "count": 8,
        "within": "15m",
        "repeat": "24h"
      },
      {
        "name": "data-silent",
        "description": "a service that normally publishes all the time went quiet",
        "title": "{device} stopped publishing",
        "resolved_title": "{device} publishes again",
        "type": "silence",
        "group": true,
        "topics": [
          "zigbee2mqtt/#",
          "hue/#",
          "haus/strom"
        ],
        "for": "30m",
        "repeat": "24h"
      },
      {
        "name": "battery-low",
        "description": "a Zigbee sensor battery needs replacing",
        "title": "{device}: battery at {value} %",
        "resolved_title": "{device}: battery replaced",
        "type": "state",
        "topics": [
          "zigbee2mqtt/+"
        ],
        "condition": {
          "field": "battery",
          "lt": 15
        },
        "for": "1h",
        "repeat": "168h"
      },
      {
        "name": "node-disk-full",
        "description": "a filesystem of the server is nearly full",
        "title": "Disk {mountpoint} is {value} % full",
        "resolved_title": "Disk {mountpoint} has room again",
        "type": "promql",
        "query": "max by (mountpoint) (100 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs|vfat\"} / node_filesystem_size_bytes * 100) > 85",
        "for": "15m",
        "repeat": "24h"
      },
      {
        "name": "node-memory",
        "description": "the server is running out of memory",
        "title": "Server memory at {value} %",
        "resolved_title": "Server memory is fine again",
        "type": "promql",
        "query": "max((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100) > 90",
        "for": "15m",
        "repeat": "24h"
      },
      {
        "name": "job-failed",
        "description": "a Kubernetes job failed",
        "title": "Job {namespace}/{job_name} failed",
        "resolved_title": "Job {namespace}/{job_name} is gone or succeeded",
        "type": "promql",
        "query": "kube_job_status_failed > 0",
        "for": "5m",
        "repeat": "168h"
      }
    ]
  },
  "web": {
    "enabled": true,
    "port": 8080
  },
  "loglevel": "info"
}
